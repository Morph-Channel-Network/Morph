@@ -0,0 +1,100 @@
+//! Opt-in diagnostic mirrors. No native graph insertion, external funding,
+//! callback execution, routing, TLC preparation or settlement is exposed here.
+use std::{fs::File, io::Read, path::Path};
+
+use anyhow::{bail, Context, Result};
+use jsonrpsee::{types::ErrorObjectOwned, RpcModule};
+use morph_fiber_adapter::{
+    shadow::{ShadowStore, SHADOW_METHODS},
+    HookPolicy,
+};
+use serde_json::Value;
+
+const SUPPORTED_FIBER_COMMIT: &str = "a5faac7177a2a2ec086a2c6d0da1840ec9fe5703";
+
+pub(super) fn module(
+    policy_path: &Path,
+    database: &Path,
+    chain_hash: &str,
+) -> Result<RpcModule<()>> {
+    let mut bytes = Vec::new();
+    File::open(policy_path)
+        .context("open Morph shadow policy")?
+        .take(16385)
+        .read_to_end(&mut bytes)?;
+    if bytes.len() > 16384 {
+        bail!("Morph shadow policy exceeds size limit");
+    }
+    let policy: HookPolicy =
+        serde_json::from_slice(&bytes).context("invalid Morph shadow policy")?;
+    if policy.fiber_commit != SUPPORTED_FIBER_COMMIT || policy.ckb_genesis_hash != chain_hash {
+        bail!("Morph shadow policy does not match the pinned Fiber revision and initialized chain");
+    }
+    // The patch digest is deployment metadata; qualification must hash the
+    // actual patch, source, lockfile and binary. An RPC self-report is not attestation.
+    let store = ShadowStore::open(database, policy)?;
+    let mut module = RpcModule::new(store);
+    for method in SHADOW_METHODS {
+        module.register_blocking_method(
+            method,
+            move |params, store, _| -> Result<Value, ErrorObjectOwned> {
+                let (argument,): (Value,) = params.parse()?;
+                store
+                    .dispatch(method, argument)
+                    .map_err(|error| ErrorObjectOwned::owned(error.code, error.message, None::<()>))
+            },
+        )?;
+    }
+    Ok(module.remove_context())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::os::unix::fs::PermissionsExt;
+
+    #[tokio::test]
+    async fn shadow_module_is_persistent_strict_and_cannot_forward() {
+        let dir = tempfile::Builder::new()
+            .permissions(std::fs::Permissions::from_mode(0o700))
+            .tempdir()
+            .unwrap();
+        let path = dir.path().join("policy.json");
+        let policy = HookPolicy {
+            fiber_commit: SUPPORTED_FIBER_COMMIT.into(),
+            patch_hash: format!("0x{}", "01".repeat(32)),
+            ckb_genesis_hash: format!("0x{}", "05".repeat(32)),
+        };
+        std::fs::write(&path, serde_json::to_vec(&policy).unwrap()).unwrap();
+        let database = dir.path().join("shadow.sqlite");
+        assert!(module(&path, &database, &format!("0x{}", "06".repeat(32))).is_err());
+        let rpc = module(&path, &database, &policy.ckb_genesis_hash).unwrap();
+        assert_eq!(rpc.method_names().count(), 6);
+        let caps: Value = rpc
+            .call("morph_external_edge_capabilities", (serde_json::json!({}),))
+            .await
+            .unwrap();
+        assert_eq!(caps["forwarding"], false);
+        assert_eq!(caps["fiber_commit"], SUPPORTED_FIBER_COMMIT);
+        for method in ["send_payment", "graph_channels", "morph_prepare_payment"] {
+            assert!(rpc
+                .call::<_, Value>(method, (serde_json::json!({}),))
+                .await
+                .is_err());
+        }
+        assert!(rpc
+            .call::<_, Value>(
+                "morph_list_external_edges",
+                (serde_json::json!({}), serde_json::json!({}))
+            )
+            .await
+            .is_err());
+        drop(rpc);
+        let reopened = module(&path, &database, &policy.ckb_genesis_hash).unwrap();
+        let list: Value = reopened
+            .call("morph_list_external_edges", (serde_json::json!({}),))
+            .await
+            .unwrap();
+        assert_eq!(list, serde_json::json!([]));
+    }
+}
