            }
          ],
          "description": "Required for RGB++; absent for CKB."
        },
        "ckb_network_id": {
          "description": "Stable CKB network/genesis identifier, not a display name.",
          "type": "string"
        },
        "decimals": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/AssetKind"
        },
        "symbol": {
          "type": "string"
        },
        "type_script": {
          "anyOf": [
            {
              "$ref": "#/$defs/PublicScript"
            },
            {
              "type": "null"
            }
          ],
          "description": "Canonical CKB JSON Script. Display metadata never replaces this value."
        },
        "type_script_hash": {
          "description": "Required for RGB++ and absent for CKB.",
          "type": [
            "string",
            "null"
          ]
        }
      },
