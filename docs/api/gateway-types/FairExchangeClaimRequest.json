{
  "$defs": {
    "PaymentPayload": {
      "additionalProperties": false,
      "properties": {
        "payer": {
          "description": "Morph account identity: blake2b-256(compressed secp256k1 public key).",
          "type": "string"
        },
        "payer_pubkey_sec1": {
          "description": "SEC1-compressed secp256k1 public key, encoded as 0x-prefixed hex.",
          "type": "string"
        },
        "payer_signature": {
          "description": "Raw 64-byte secp256k1 ECDSA signature over the canonical authorization digest.",
          "type": "string"
        },
        "payment_hash": {
          "type": "string"
        },
        "payment_preimage": {
          "type": [
            "string",
            "null"
          ]
        },
        "requirement_id": {
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "payment_hash",
        "payer",
        "payer_pubkey_sec1",
        "payer_signature"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "credential_ttl_seconds": {
      "anyOf": [
        {
          "description": "Canonical unsigned decimal string in 0..=18446744073709551615. Units are documented on the field.",
          "maxLength": 20,
          "minLength": 1,
          "not": {
            "pattern": "[^0-9]"
          },
          "pattern": "^(0|[1-9][0-9]{0,18}|18446744073709551615|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]{1}|1844674407370955161[0-4][0-9]{0})$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "offer_id": {
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/PaymentPayload"
    }
  },
  "required": [
    "offer_id",
    "payload"
  ],
  "title": "FairExchangeClaimRequest",
  "type": "object"
}
