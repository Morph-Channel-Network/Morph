        },
        "ckb_network_id": {
          "description": "Stable CKB network/genesis identifier, not a display name.",
          "type": "string"
        },
        "decimals": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/AssetKind"
        },
        "symbol": {
