          "type": "string"
        }
      },
      "required": [
        "schema",
        "draft",
        "exit_signatures",
        "creation_signatures"
      ],
      "type": "object"
    },
    "RootFundingDraft": {
      "additionalProperties": false,
      "description": "Public immutable funding proposal. Every amount and the initial exit are\nderived from the packed transaction; no duplicate roots or amounts exist.",
      "properties": {
        "participants": {
          "items": {
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "schema": {
          "type": "string"
