    "RootFundingCollection": {
      "additionalProperties": false,
      "description": "Public coordination state. It contains no signer authority or reservation.",
      "properties": {
        "creation_signatures": {
          "items": {
            "$ref": "#/$defs/SignatureMessage"
          },
          "type": "array"
        },
        "draft": {
          "$ref": "#/$defs/RootFundingDraft"
